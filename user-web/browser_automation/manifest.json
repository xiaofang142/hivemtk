{
  "manifest_version": 3,
  "name": "HiveMTK Browser Automation",
  "version": "1.2.0",
  "description": "HiveMTK 浏览器自动化扩展（寄生式后台 tab + Native Messaging）",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HiveMTK 浏览器自动化"
  },
  "icons": {
    "128": "icons/128.png"
  }
}