# 生产环境配置
# =============================================================
# 单一源约束（端口/URL 默认值）
# 单一代码源：hivemtk/user-server/internal/config/ports.go
# 单一文档源：hivemtk/user-server/docs/dev/DEVELOPMENT.md §2.4 端口对照表
# 跨包对齐：
#   - user-server DefaultUserServerBaseURL="http://localhost:8204"
# =============================================================
NODE_ENV=production

# API 基础地址：同源相对路径。前端与 user-server 由同一 反向代理层 同源托管，
# /api 直接反代到后端，彻底消除跨域(CORS)依赖。
# 若确实要前后端分离到不同 origin，把这里改成绝对地址并同步配置 CORS_ALLOW_ORIGINS_USER。
VITE_API_BASE_URL=/

# 是否开启 mock
VITE_USE_MOCK=false