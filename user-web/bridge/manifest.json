{
  "manifest_version": 3,
  "name": "HiveBridge 蜂桥 — 抖音/小红书/TikTok/闲鱼/快手 私信桥接",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "version": "1.0.4",
  "description": "将抖音/小红书/TikTok/闲鱼/快手 网页私信实时桥接到 HiveMTK AI 智能体（user-server），支持多账号、消息历史回填与拟人限速风控。",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://*/*",
    "https://*/*",
    "wss://*/*",
    "ws://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HiveBridge 蜂桥 — 私信桥接",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.douyin.com/*"
      ],
      "js": ["content-douyin.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.xiaohongshu.com/*"
      ],
      "js": ["content-xhs.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.tiktok.com/*"
      ],
      "js": ["content-tiktok.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.goofish.com/*",
        "https://*.xianyu.com/*"
      ],
      "js": ["content-xianyu.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.kuaishou.com/*"
      ],
      "js": ["content-kuaishou.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
