    "@vue-flow/minimap": "^1.5.4",
    "@vue/compiler-sfc": "^3.5.22",
    "axios": "^1.9.0",
    "dompurify": "^3.4.12",
    "echarts": "^6.0.0",
    "element-plus": "^2.9.11",
    "mjml-browser": "^4.15.3",
    "pinia": "^3.0.2",
    "sass": "^1.89.1",
    "tinymce": "7.9.3",
