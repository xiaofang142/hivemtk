# ============================================================
# HiveMtk 用户端 - 环境变量示例（2026-08-17 宿主机部署重构版）
# ------------------------------------------------------------
# 复制为 .env 后修改默认值。
#
# 部署定位（2026-08-17 重构）：
#   - Docker 仅提供数据层：PG + Redis（docker-compose.yml，端口绑 127.0.0.1）
#   - 推理层（llm/embedding/rerank）走宿主机 llama.cpp / MLX（scripts/inference-host/）
#   - user-server 二进制 / user-web 都在宿主机跑（user-server 用 air 或 go build 二进制）
#   - LLM 提供商配置（base_url / model / api_key / temperature 等）通过后台
#     「LLM 路由」页面操作写入数据库表 llm_providers，启动时 LoadProvidersFromDB 加载
#   - 平台端（hivemtk-platform）与本用户端物理隔离，通过 PLATFORM_API_HOST 跨网络调用
#
# =============================================================
# 单一源约束（端口/URL 默认值）
# 权威文档源：hivemtk/docs/PORT_REGISTRY.md（**唯一权威**，含改端口铁律）
# 单一代码源：hivemtk/user-server/internal/config/ports.go
# 审计脚本  ：bash scripts/audit-cross-package-ports.sh（改完必须跑）
# 跨包对齐：
#   - user-server DefaultListenPort="8204"（服务端读 PORT；USER_SERVER_PORT 只给脚本拼 curl 目标）
#   - user-server DefaultDBPortDev=8232 / DefaultDBPortDocker=8202（USER_POSTGRES_HOST_PORT）
#   - user-server DefaultRedisPort="8203"（REDIS_HOST_PORT）
#   - user-server DefaultLLMPort=8207（LLM_PORT）
#   - user-server DefaultEmbeddingPort=8208（EMBEDDING_PORT）
#   - user-server DefaultRerankPort=8209（RERANK_PORT）
#   - user-server DefaultPlatformPort="8205"（PLATFORM_API_HOST）
#
# 严禁"软启动"——本文件端口字面量必须与 ports.go / PORT_REGISTRY.md 严格一致。
# 调整流程（docs/PORT_REGISTRY.md §3.2）：
#   1) 改 ports.go 常量
#   2) 改本文件 + docker-compose.yml + config.yaml（仅注释/默认值）
#   3) 跑审计脚本
#   4) 更新 PORT_REGISTRY.md 变更记录
# =============================================================
#
# 所有配置可由部署环境变量覆盖（user-server 启动时自动读取）；
# .env 文件由 make install 生成并由 user-server 进程启动前 source 注入。
# ============================================================

# ==================== 镜像标签（保留兼容字段）====================
# TAG=latest
# 历史遗留，当前代码无读取点，勿改/勿依赖

# ==================== PostgreSQL（Docker 数据层）====================
# 权威端口表：docs/PORT_REGISTRY.md §一
# 容器内固定 8202（docker-compose postgres.port=8202），宿主机映射可覆盖
# 两种模式：
#   · Docker 数据层模式（默认）：USER_POSTGRES_HOST_PORT=8202 / DB_PORT=8202
#   · 宿主机直连 Dev 模式（避开 8202 历史占用）：USER_POSTGRES_HOST_PORT=8232 / DB_PORT=8232
# 改端口流程：docs/PORT_REGISTRY.md §3.2 — 改完必须跑 bash scripts/audit-cross-package-ports.sh
POSTGRES_USER=admin
POSTGRES_PASSWORD=ChangeMe_To_Strong_Password_123!

USER_DB_NAME=user_db
# 宿主机端口：容器内 8202 → 宿主机（可选改，默认 8202，建议 dev 档用 8232）
USER_POSTGRES_HOST_PORT=8202
# user-server 连接 PG 的实际端口（必须与上面 USER_POSTGRES_HOST_PORT 同步！）
# config.yaml 读取 DB_HOST/DB_PORT，默认值已对齐：DB_PORT 默认 8232 但会被本环境变量覆盖
DB_HOST=127.0.0.1
DB_PORT=8202

# 专用测试库（docker-compose.test.yml，fsync=off）：只给 go test 用，数据可丢。
# 与业务库 USER_POSTGRES_HOST_PORT 分开，默认 8217；启动：make test-db-fast-up
USER_POSTGRES_TEST_HOST_PORT=8217

# ==================== Redis（Docker 数据层）====================
REDIS_HOST_PORT=8203
REDIS_PASSWORD=ChangeMe_To_Strong_RedisPass_789!
# user-server 连接 Redis 的实际地址（main.go buildRedisClient 读取）
REDIS_HOST=127.0.0.1
REDIS_PORT=8203

# ==================== 应用端口 ====================
# 服务监听端口：Go 进程读 PORT（cmd/api/main.go resolveListenAddr）；
# USER_SERVER_PORT 只给 scripts/{bootstrap,deploy-user,rotate-secrets}.sh 拼 curl 目标用，
# 改它挪不动服务监听 ⇒ 两个必须一起改。
PORT=8204
USER_SERVER_PORT=8204
# 监听主机：默认仅本机（127.0.0.1）——登录口只开给本机，对外访问走反向代理。
# 需要局域网内设备直连 8204（浏览器扩展 / 真机联调）时改成 0.0.0.0（全网卡）。
# 注：Go 侧不设 SERVER_HOST 时的缺省仍是 0.0.0.0（cmd/api/main.go resolveListenAddr），
# 取消注释后以这里的值为准。
SERVER_HOST=127.0.0.1

# ==================== 反向代理 / 真实客户端 IP ====================
# 可信反向代理名单（user-server/internal/middleware/client_ip_guard.go 读取）。
# 语义：只有来自名单内地址的 X-Forwarded-For / X-Real-IP 才被采信为该请求的真实客户端 IP；
#   名单为空（默认）时该中间件不接管，ClientIP() 行为与升级前逐字节一致。
# 格式：逗号分隔的单 IP 或 CIDR（例：10.0.0.0/8,172.16.0.1）。
# 为什么必须显式配：不配时若前面有反代，服务端看到的永远是反代 IP——
#   登录风控、频控、审计日志里的"来源 IP"会全部塌成同一个值，且不会有任何报错。
TRUSTED_PROXIES=

# ==================== JWT / 安全密钥 ====================
# OPT-SEC-08：所有 secret 必须从环境变量/KMS 加载，禁止硬编码
# 生产部署建议：使用 Vault / AWS Secrets Manager / 阿里云 KMS 注入
# 最小长度要求：
#   - JWT_SECRET: ≥ 32 字符（启动时 panic 检查）
#   - FIELD_ENCRYPTION_KEY: ≥ 32 字符（OPT-SEC-04 字段加密使用）
#   - MERCHANT_API_SECRET: ≥ 32 字符（merchant-api HMAC 签名）
JWT_SECRET=ChangeMe_To_32Char_Random_JWT_Secret_Key_For_Production
# JWT 有效期硬编码 24h（internal/pkg/utils/jwt.go），无 env 可配
PLATFORM_ADMIN_PASSWORD=ChangeMe_To_Strong_Password_For_User_Admin

# 字段加密密钥（OPT-SEC-04 api_logs / audit_logs 敏感字段加密使用）
# 必须 ≥ 32 字符
# 重要：轮换密钥会失效所有已加密字段，需先解密再轮换
FIELD_ENCRYPTION_KEY=ChangeMe_To_32Char_Field_Encryption_Key_Random

# 商户 HMAC 签名密钥（merchant-api 鉴权使用；user-server 经 config/platform.yaml 的 secret: "${MERCHANT_API_SECRET}" 消费）
MERCHANT_API_SECRET=ChangeMe_To_32Char_Merchant_HMAC_Key_For_Signing

# 生产环境必填：数据静态加密主密钥，缺失将拒绝启动（openssl rand -hex 32 生成）
MASTER_KEY=
# 生产环境必填：演示种子口令；不设则 seed 命令使用公开默认值 Seed@123456，对外交付必须显式设置
SEED_PASSWORD=

# ==================== 平台集成（可选本地组件）====================
# 平台端（hivemtk-platform）是**可选**组件，默认不启用：
#   false / 不设置 = 纯本地模式。不加载 config/platform.yaml、不注册商户、不心跳、
#   不发任何平台请求；资产市场与平台上报类接口返回空数据，本地资产构建与运行不受影响。
#   true            = 自建并跑起 platform-server（默认 127.0.0.1:8205）时才需要。
# 只有开启时，下面的 PLATFORM_API_HOST / MERCHANT_API_SECRET / PLATFORM_ADMIN_PASSWORD 才会被读取。
PLATFORM_ENABLED=false

# ==================== 平台 API URL（用户端调用平台端，仅 PLATFORM_ENABLED=true 时生效）====================
# user-server 跑在宿主机，平台端可能也在宿主机或独立机器
#   - 同机：http://127.0.0.1:8205
#   - 跨机：https://api.example.com
# 注意：user-server(internal/config/platform.go) 实际读取 PLATFORM_API_HOST，不是 PLATFORM_API_URL
PLATFORM_API_HOST=http://127.0.0.1:8205

# ==================== 云端版地址（003 T003 · public config 展示字段）====================
# /api/public/config 下发的 cloud_url（与 edition=opensource|saas 同点下发，前端据此渲染「云端版」入口）。
# 优先级：config/platform.yaml 的 cloud_url > 本环境变量 > 内置占位常量 https://saas.hivemtk.cn
# 离线（PLATFORM_ENABLED=false）不加载 platform.yaml，此时本变量即生效项；上线前替换为正式域名。
# PLATFORM_CLOUD_URL=https://saas.hivemtk.cn

# ==================== 应用模式 ====================
GIN_MODE=release

# ==================== 部署形态（SaaS 多租户 / 离线单机）====================
# TENANT_MODE 决定系统形态，同一份代码两种部署（specs/001-saas-multi-tenant）：
#   off（默认）离线单机版：全部数据归属默认租户，行为与历史版本完全一致；
#         租户自助注册入口关闭（业务码 4104）；存量实例升级零配置。
#   on          SaaS 多租户版：开放一键开户注册、租户数据行级隔离、
#         后台任务按租户扇出、LLM 租户自有配置优先/平台池兜底。
# 未知值一律按 off 处理（fail-safe 朝向历史行为）。
# TENANT_MODE=off
TENANT_MODE=off
# 默认租户 ID：离线单机全部数据的归属租户（一般不改）
# DEFAULT_TENANT_ID=1

# SITE_TENANT_CODE 站点默认租户短码（SaaS 模式建议配）：
#   匿名访问 /api/public/config（登录页站点名 / 注册入口）时，请求没带 tenant_code
#   或 X-Tenant-Code 头，就用它解析站点归属。SaaS 下登录页本来就没有短码，
#   不配会让公开配置回保守值（注册入口隐藏）。
#   配错（短码查不到租户）同样回保守值，不会假开注册；离线单机不用配。
# SITE_TENANT_CODE=your_site_tenant_code

# ============================================================================
# 私域部署护栏（v3 审计 P0-S1 · 强烈建议保持 true）
# ============================================================================
# 设为 true 时，user-server 启动会校验 PUBLIC_BASE_URL 解析结果，
# 任何公网 IP 暴露将启动失败。生产环境必须 true。
REQUIRE_PRIVATE_NETWORK=true

# 公开访问 URL（FRP 反代后的 URL 或内网 IP）
# 留空 = 跳过校验（仅 dev 模式）
# 生产环境必须填，且必须是内网/FRP URL
PUBLIC_BASE_URL=

# ==================== 官网基址（GEO 落地页 + 自家站判定的单一源）====================
# GEO 关键词爬虫要投的落地页、以及"这条访问是不是自家站"的判定都从这里拼 URL。
# 留空 = 取代码内默认值（user-server/internal/config/ports.go 的 DefaultWebsiteBaseURL，
#        即 GitHub Pages 上的本项目页）。
# 换成自己的官网时填到**项目根**这一级；结尾带不带 / 都行，读取处会裁掉。
# 判定按"基址 + 路径边界"匹配，所以同一 host 上别人的项目页不会被误算成自家。
GEO_SITE_BASE_URL=

# 发布目标 SSRF 校验旁路：仅测试环境（httptest 回环/内网地址）设为 1，
# 生产必须留空/0——否则平台账号可被配置成访问内网服务。
GEO_ALLOW_PRIVATE_PUBLISH_HOSTS=

# GEO 建站（Hugo 静态站）工作根：站点文件默认落系统临时目录，生产必须指向
# 持久卷，否则重启丢站、发布审计无从核对。路径被 validateHugoPath 钉在
# GEO_SITE_ROOT/<tenant_id>/ 之下（读取点 internal/geo/service/geo_site.go）。
GEO_SITE_ROOT=

# ==================== CORS 跨域配置 ====================
# 用户端 API 允许的前端域名（逗号分隔）。
# 白名单须含各平台域名（xhs/dy/tt/xianyu）：content script 在私信页 fetch 上报
# /api/bridge/ingest 时 Origin 是平台域名，不含则 CORS preflight 失败、POST 发不出去。
CORS_ALLOW_ORIGINS_USER=https://user.example.com,https://www.xiaohongshu.com,https://www.douyin.com,https://www.tiktok.com,https://www.goofish.com

# ==================== 七牛云存储（密钥由环境变量注入，不落配置文件）====================
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# ==================== 邮箱配置 ====================
# QQ_NUMBER=
# 历史遗留，当前代码无读取点，勿改/勿依赖
QQ_EMAIL=
QQ_EMAIL_PASSWORD=
EMAIL_163_USER=
EMAIL_163_PASSWORD=
EMAIL_163_SMTP_HOST=smtp.163.com

# =============================================================================
# 宿主机 llama.cpp / MLX 推理栈（2026-08-17 重构）
# -----------------------------------------------------------------------------
# 三个能力全部由宿主机 llama-server 提供，OpenAI 兼容：
#   - LLM       : /v1/chat/completions   (port 8207)
#   - Embedding : /v1/embeddings         (port 8208)
#   - Rerank    : /v1/rerank             (port 8209)
# 数据层：PG 127.0.0.1:8202 / Redis 127.0.0.1:8203（docker compose）
#
# ⚠️ LLM 提供商配置说明（2026-08-17 重构）：
#   - LLM 的 base_url / model / api_key / temperature / max_tokens 等运行时配置
#     一律通过后台「LLM 路由」页面（POST /api/llm/models）写入数据库表 llm_providers，
#     user-server 启动时经 LoadProvidersFromDB 加载，覆盖以下环境变量默认值。
#   - 场景路由规则持久化到 llm_routing_rules 表，由 /api/llm/scene-routing 管理。
#   - 下方 LLM_BASE_URL / LLM_MODEL / LLM_API_KEY 仅作为「本地推理栈」的默认指向
#     与首次启动占位；生产 LLM 提供商请在 UI 配置。
#
# 启动顺序：bash scripts/inference-host/install-llama-cpp.sh → download-models.sh
#           → start-all.sh → warmup.sh → smoke-test.sh
# 推荐入口：make install (一键全流程) / make dev-all (启动数据+推理)
# =============================================================================

# ---- 宿主机路径 ----
# 模型根目录：默认保存在本项目 hivemtk/models/ 下（.gitignore 已忽略大文件）
# 目录结构：$HIVEMTK_MODELS_DIR/{llm,embedding,rerank}/<file>.gguf
# 生产部署可指向独立数据盘：HIVEMTK_MODELS_DIR=/data/hivemtk/models
# HIVEMTK_MODELS_DIR=./models
# 运行时目录：pid / log（运行时产物，默认在 $HOME/.hivemtk/runtime）
# HIVEMTK_RUNTIME_DIR=$HOME/.hivemtk/runtime
# 安装态锁文件 install.lock：记本机安装身份（install_id / admin_username / initialized）。
# 不配时默认 ./install.lock —— 相对的是**进程 CWD**，从哪个目录启动就写在哪个目录。
# 换目录重启＝旧锁留在原地、新进程读不到，于是回填铸一枚新的 install_id：
# 平台侧（PLATFORM_ENABLED=true）纯按 install_id 记商户，同一台机器会多出一个新装商户、
# 旧历史再也接不上。所以生产必须写成绝对路径，且该目录要随实例持久化（别放临时卷）。
# INSTALL_LOCK_PATH=/var/lib/hivemtk/install.lock

# ---- llama.cpp 二进制路径（自动探测，亦可手动指定）----
# macOS Apple Silicon: /opt/homebrew/bin/llama-server
# macOS Intel / Linux brew: /usr/local/bin/llama-server
# Linux apt: /usr/bin/llama-server
# LLAMACPP_BIN=llama-server

# ---- 模型 profile（dev | prod | ornith）----
HIVEMTK_PROFILE=dev

# ---- 模型下载源顺序（逗号分隔）----
DOWNLOAD_SOURCE=modelscope,hf-mirror,hf

# ---- user-server 调 llama-server 的地址（与 .air.toml / config.yaml 一致）----
LLM_BASE_URL=http://127.0.0.1:8207/v1
LLM_API_KEY=local
LLM_MODEL=Qwen2.5-3B-Instruct

EMBEDDING_BASE_URL=http://127.0.0.1:8208/v1
EMBEDDING_API_KEY=
# 协议分支：留空/openai=OpenAI 兼容 /v1/embeddings；tei=TEI 原生 /embed（请求 {inputs}）
EMBEDDING_PROTOCOL=
EMBEDDING_ALLOW_FALLBACK=false

RERANK_BASE_URL=http://127.0.0.1:8209
RERANK_API_KEY=
RERANK_ENABLED=true
# 协议分支：留空/openai=OpenAI 兼容端点（/v1/rerank）；dashscope=阿里云原生端点
#（/api/v1/services/rerank/text-rerank/text-rerank，compatible-mode 无 /v1/rerank）；
# tei=TEI 原生端点（POST /rerank，请求 query/texts，响应 [{index,score}]）
RERANK_PROTOCOL=

# ---- 端口分配（一般无需修改）----
LLM_PORT=8207
EMBEDDING_PORT=8208
RERANK_PORT=8209

# ── P1-1 文档解析升级（默认全关＝零外网请求） ──
# 外挂解析服务（RAGFlow/MinerU 适配器，契约见 docs/DEPLOYMENT_GUIDE.md「外挂解析与图片知识库」）
PARSER_SIDECAR_URL=
# 图片知识库：本地 VL 推理（OpenAI chat completions 兼容）
IMAGE_DESCRIBE_URL=
IMAGE_DESCRIBE_MODEL=vl
# Laya 决策服务（ModernBERT-large 421M，非自回归 choice/score/noul；host-only torch 服务）
LAYA_PORT=8210

# ---- 推理参数（按需调优）----
CTX_SIZE=8192
THREADS=0
NGL=0
# macOS Apple Silicon Metal: NGL=999（GPU 全卸载）
# 纯 CPU: NGL=0
# NVIDIA GPU: NGL=999
BATCH_SIZE=512
LLM_PARALLEL=4

# =============================================================================
# 宿主机 llama.cpp 推理栈模型定义
# -----------------------------------------------------------------------------
# 三个角色的仓库/文件/别名，与 inference-host scripts 共享
# 调参只改这里，scripts 自动读取
# =============================================================================

# —— LLM：Qwen2.5-3B-Instruct Q4_K_M（2.0GB，支持 ReAct FC）——
LLM_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
LLM_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
LLM_SERVED_NAME=Qwen2.5-3B-Instruct
LLM_CTX_SIZE=32768

# —— Embedding：bge-m3 Q4_K_M（417MB，1024 维）——
EMBEDDING_REPO=Xorbits/bge-m3-gguf
EMBEDDING_FILE=bge-m3-Q4_K_M.gguf
EMBEDDING_SERVED_NAME=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_CTX_SIZE=8192

# —— Rerank：bge-reranker-v2-m3 Q4_K_M（418MB）——
RERANK_REPO=puppyM/bge-reranker-v2-m3-Q4_K_M-GGUF
RERANK_FILE=bge-reranker-v2-m3-q4_k_m.gguf
RERANK_SERVED_NAME=bge-reranker-v2-m3
RERANK_CTX_SIZE=2048

# —— Laya 决策模型：convaiinnovations/laya（ModernBERT-large 421M，非 GGUF）——
# 注意：不走 llama.cpp，由 scripts/inference-host/laya/server.py（torch）提供 POST /v1/decide
LAYA_REPO=convaiinnovations/laya
LAYA_SERVED_NAME=laya
# 推理设备：auto（torch 自动选 MPS/CUDA/CPU）。本机实测 torch 2.12 + macOS 27 上 MPS
# 单次 forward 约 150s（疑似 MPS 回退），故默认 cpu；有可用 CUDA/MPS 且验证过延迟再改。
LAYA_DEVICE=cpu

# ==================== 日志 ====================
LOG_LEVEL=info

# ==================== MCP 工具调用入口凭证（POST /api/mcp）====================
# 不配也能跑：本入口在未配置专用凭证时**回落**认桥接凭证（system_config_kv.bridge_ingest_token），
# 等价于历史行为，存量部署不会因为拆分而 401。
# 一旦配置，X-Bridge-Token 就不再换得到工具调用权限（每台运营机器上都有那枚扩展凭证，
# 而 MCP 能触发服务端工具：发消息、写客户数据、跑触达管线）。
# MCP_TOKEN_PREV 是轮换位：新旧两值同时有效，避免一次改配置把全部调用方踢下线。
# 两者都没配时本入口 503 fail-closed，且**不跟随** BRIDGE_INGEST_AUTH=off。
# MCP_TOKEN=
# MCP_TOKEN_PREV=

# ==================== LTC 灰度旗（装配期各读一次，改档必须重启 user-server）====================
# 三旗详细档位语义与设置后果见 docs/DEPLOYMENT_GUIDE.md §6.2 末尾"只存在于代码里"大表。
# 共同口径：默认全关（与交付前行为逐字节一致）；布尔真值一律降档 shadow 并告警，
# 不认识的值一律按关/fail-closed 处理——不给"看不懂的值"多开一档行为。
#
# 订单草稿持久化：off（默认，不装配，草稿内存态且到期无人清扫）
# | shadow（读走内存 + 镜像进库对照，Durable=false，重启仍丢）
# | on（权威副本交给 order_drafts 表；转 on 前先核对 /api/agent/order-drafts/stats）。
#FF_LTC_ORDER_DRAFT_DB=off
#
# 转人工待办 SLA 超时闭环：off（默认，逾期只被数不被办）
# | shadow（只扫只数打日志，一条不写）| enforce（真发站内提醒 + 拖过完整 SLA 窗口广播升级）。
# 要真写必须显式写 enforce，写 true/1 会被降档成 shadow 并告警。
#FF_LTC_HANDOFF_SLA_JOB=off
#
# AI 谈单响应后的分发路径（两态，无 shadow）：off（默认，只建草稿，行为同从前）
# | 真值（true/1/yes/on）由 SalesActionTrigger 接管（打标/推旅程/建草稿/排跟进/记事件）。
# 与 FF_LTC_ORDER_DRAFT_DB 互斥分流、不可叠加——同一意向被两条路径各处理一次
# 会让 pending 草稿数量翻倍，那是假订单数据。
#FF_LTC_SALES_TRIGGER=off

# ============ 内容安全闸（异步审查流水线；装配期读一次，改档必须重启 user-server）============
# 完整语义、出厂策略与差距清单见 docs/DEPLOYMENT_GUIDE.md §6.2 末的 CONTENT_GUARD_* 行、
# docs/architecture/adr/ADR-017-content-guard-async-pipeline.md、docs/architecture/CONTENT_MODERATION_RESEARCH.md。
#
# 本地词库（guard_words）+ 异步 worker（guard_tasks）是**默认的全部**能力，不需要配置任何键。
# 下面这组只调流水线形状，都能不配。
#CONTENT_GUARD_WORKERS=2          # worker 协程数
#CONTENT_GUARD_BATCH=32           # 单轮领取条数
#CONTENT_GUARD_POLL_MS=2000       # 兜底轮询间隔（正常靠进程内 notify 唤醒）
#CONTENT_GUARD_MAX_ATTEMPTS=5     # 用尽即转 failed 死信（查死信需直查 guard_tasks 表）
# 审查长度上限**不在 env**：它在参数中心 `content_guard.max_scan_runes`（默认 20000 rune，
# 可用区间 [1000, 200000]，装配期读一次 ⇒ 改完要重启 user-server）。
#
# 外部审核 API：**默认关＝数据零出域**。开它就是"把用户原文发给第三方"，
# 属数据出域决策，必须由部署方显式做；且策略里的 api_enabled 还要再开一次（双重显式）。
#CONTENT_GUARD_API_ENABLED=false
#CONTENT_GUARD_API_ENDPOINT=      # 完整 URL；开了 ENABLED 但这里为空 ⇒ warn + 不启用
#CONTENT_GUARD_API_TOKEN=         # Bearer 令牌，空 ⇒ 不带 Authorization 头
#CONTENT_GUARD_API_HOSTS=         # 逗号分隔白名单；**非空才校验**，为空只允许 https
#CONTENT_GUARD_API_TIMEOUT_MS=3000
#CONTENT_GUARD_API_ALLOW_INSECURE=false  # 允许 http/私网地址，仅供本地联调或内网自建审核服务

# T1 低置信回流：异步收集器灰度开关（默认关）。开 = 低置信/兜底问题沉淀进
# unknown_questions 并自动 trgm 归簇（service/reflux，有界队列 + 队满丢弃）。
REFLUX_ENABLED=false

# 二次审核自动外发开关（db55b1b5 批新增；审核通过后是否自动把报价外发给客户）
# on（缺省，自动外发）| off（关闭自动外发，审核通过后需人工发送）。认不清的值降档 off。
#FF_LTC_APPROVAL_AUTO_SEND=on

# ── 测试基础设施（仅本地 go test 使用，生产不读） ─────────────────────
#TESTDB_TIMING=1        # 输出 NewTestDB 各阶段耗时（定位整套用例的建库成本）
#TESTDB_LEGACY=1        # 回退旧的「每用例 DropTable+AutoMigrate」建库路径
#TESTDB_STATEMENT_TIMEOUT=60s   # 测试库 statement_timeout（防单条 SQL 卡死整轮；仅接受 500ms/60s/5min/1h 形式）
#TESTDB_LOCK_TIMEOUT=15s        # 测试库 lock_timeout（锁等待超时即失败，不无限挂起）
#TESTDB_CLOSE_TIMEOUT=30s       # 每用例连接池 Close 的有界等待；超时即判失败并提示泄漏事务
