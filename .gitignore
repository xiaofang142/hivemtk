# ============================================================
# 用户端 (HiveMtk) - .gitignore
# 私域独立部署仓库（2026-07-21 拆分）
# ============================================================

# ---------- 依赖 ----------
node_modules/
vendor/
__pycache__/
*.pyc
*.pyo

# ---------- 环境配置（含敏感信息）----------
.env
.env.local
.env.*.local
*.env
# 说明：.env 为本地真实配置（忽略）；.env-example 为示例模板，纳入版本追踪。
# 例外：推理栈模型定义文件（非敏感配置，需纳入版本追踪）
!scripts/inference-host/models.env

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.workbuddy-ai/*

# ---------- 运行时产物（PID / 进程日志）----------
.runtime/

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
.claude/
.trae/
.sisyphus/
.codebuddy/
.codeartsdoer/
.opencode/
.arts/
.freebuff/
.planning/
.playwright-cli/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ---------- 构建产物 ----------
# dist 目录内容忽略，但保留 .gitkeep 占位
**/dist/*
!**/dist/.gitkeep
build/
*.exe
*.app
# Go 服务二进制
/user-server/cmd/api/api
/user-server/cmd/*/api
/user-server/api
/user-server/merchant_server
/user-server/marketing
/user-server/perf
/user-server/user-server
/user-server/reset-admin
/user-server/main-bin
/user-server/tmp/
/user-server/embedding-server
/user-server/bin/
/user-server/internal/plugin/main/*.so
/user-server/internal/*.so

# i18n 生成缓存
*.fill_cache.json

# 图片资源（体积大，不纳入版本追踪；本地保留即可）
# 例外：README 展示截图 docs/screenshots/screenshot-*.png 必须入库
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
!docs/screenshots/screenshot-*.png
# 离线包构建产物
dist-offline/

# ---------- 测试覆盖 ----------
coverage/
*.cover
*.cover.out
*.out
*.test
*.prof
playwright-report/
playwright-report-api/
test-results/

# ---------- 临时文件 ----------
tmp/
temp/
uploads/
downloads/
.data/
.round
.round.*

# ---------- 数据库 / 持久化数据 ----------
*.db
data/
# PG 数据绑定挂载目录（docker-compose ./pg_data）
pg_data/
# 模型文件（./models/ 实际不提交，仅 README 与 .gitkeep）
models/

# ---------- Docker ----------
docker-compose.override.yml
# 说明：docker-compose.yml 为宿主机部署版编排（仅数据层 PG+Redis），纳入版本追踪。
#       真实密钥通过 .env（被忽略）注入，编排文件不保留敏感配置。

# ---------- 证书和密钥 ----------
*.pem
*.key
*.crt
*.p12

# ---------- 备份与缓存 ----------
*.bak
*.backup
*.bak.*
backups/

# ---------- 编译产物（通用）----------
main
*.dll
*.so
*.dylib
# 打包 / 发布产物（由 CI 或本地构建生成，不纳入版本追踪）
*.zip
*.tar.gz

# ---------- 一次性调试产物 ----------
debug-*.html
reset-*.html
clear-*.html
fix-api-config*.html
debug-*.js
debug-*.sh
test_all_apis*.sh
test-all-apis*.sh

# ---------- 临时 restore 目录 ----------
user-server/internal/service/restore_tmp/

# ---------- 运行时授权文件 ----------
merchant.key
install.lock

# ---------- 嵌入 SDK 构建产物 ----------
/embed-sdk/dist/

# ---------- 开发工具配置 ----------
.air.toml

# ---------- 生成产物（机器生成，不应纳入版本追踪）----------
# 自动生成的代码/接口清单文档（由脚本重新生成）
user-server/NEW_FUNCTIONS_INVENTORY.md
# 前端测试 / UI 扫描生成的产物与缓存（由脚本重新生成）
user-web/tests/API_TEST_RESULTS.json
user-web/tests/API_INVENTORY.json
user-web/tests/.api_id_cache.json
user-web/docs/ui-inventory/inventory.json
# 页面级端到端审计脚手架运行时产物（由脚本重新生成，非源码）
user-web/tests/audit/reports/
user-web/tests/e2e/audit/reach/
user-web/tests/e2e/audit/summary.json
# 临时运行日志（前端桥接运行输出，非源码）
user-web/_bridge_run.txt

# simulate 运行时数据（脚本产物，非源码）
*.jsonl

# ---------- 内部/敏感文档：不对外公开，仅本地留存于仓库外 internal-docs/ ----------
# 含内部需求/设计逻辑/审计结论/真实客户数据，禁止进入公开仓库。
customer-service/
docs/audit/
docs/bridge/
user-server/docs/audit/
.research/
*-research.md
internal-docs/
.env.geo.local
user-server/geo-run

# ---------- 编译产物（62MB 已 commit 过，GitHub warning）----------
mtk-serve
*.exe

# ---------- 模型数据文件（>1GB，不应进 git）----------
*.gguf
*.mlx
*.safetensors
*.bin
*.pt
