[31m+ async function reAckSentDuplicates(cred, entries, label) {[39m
[31m+   const withConv = [];[39m
[31m+   for (const e of entries) {[39m
[31m+     if (e.conversation_id && e.conversation_id !== '_unknown_') withConv.push(e);[39m
[31m+     else log.warn(`${label} 缺少会话归属，无法安全补确认`, { channel: cred.channel, msg_id: e.msg_id });[39m
[31m+   }[39m
