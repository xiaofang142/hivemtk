[31m+ export async function withTimeout(promise, ms, label) {[39m
[31m+   if (!ms || ms <= 0) return promise;[39m
[31m+   let timer = null;[39m
[31m+   const timeout = new Promise((_, rej) => {[39m
[31m+     timer = setTimeout(() => rej(new Error(`${label} timeout after ${ms}ms`)), ms);[39m
[31m+   });[39m
[31m+   try {[39m
[31m+     return await Promise.race([promise, timeout]);[39m
[31m+   } finally {[39m
[31m+     if (timer) clearTimeout(timer);[39m
[31m+   }[39m
[31m+ }[39m
[31m+[39m
[31m+ // sleep：限速重试等待（拟人节奏，避免被识别为机器人）。[39m
[31m+ const sleep = (ms) => new Promise((r) => setTimeout(r, ms));[39m
[31m+[39m
[31m+ // rateRetryBaseMs：单行限速重试的等待时长（对齐三层风控的拟人节奏）。[39m
[31m+ // 取全局最小间隔 + 随机抖动，使"紧接其后的另一会话"在等待后能通过 minInterval 校验。[39m
[31m+ function rateRetryBaseMs() {[39m
[31m+   const { minIntervalMs, jitterMinMs, jitterMaxMs } = RATE_LIMIT_DEFAULTS;[39m
[31m+   const jitter = jitterMinMs + Math.random() * Math.max(0, jitterMaxMs - jitterMinMs);[39m
[31m+   return minIntervalMs + jitter;[39m
[31m+ }[39m
