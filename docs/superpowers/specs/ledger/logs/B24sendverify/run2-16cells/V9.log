[31m+   const ids = withConv.map((e) => e.msg_id);[39m
[31m+   const res = await ackOutbox(cred, ids, { label, items: withConv });[39m
[31m+   const S = BRIDGE_PROTOCOL_V2.RESPONSE_STATUS;[39m
[31m+   const items = res && res.status === 'ok' && Array.isArray(res.items) ? res.items : null;[39m
[31m+   if (!items) {[39m
[31m+     if (res && res.status === 'ok') {[39m
[31m+       // items 缺失 = 老服务端按全量成功处理（与正常下发 ack 同口径），不入重试队列[39m
[31m+       log.info(`${label} 已补确认`, { channel: cred.channel, count: ids.length });[39m
[31m+       return;[39m
[31m+     }[39m
[31m+     for (const e of withConv) addPendingAck(cred.channel, e.msg_id, 'duplicate_reack_failed', e.conversation_id);[39m
[31m+     log.warn(`${label} 失败，转入重试队列`, { channel: cred.channel, count: ids.length });[39m
[31m+     return;[39m
[31m+   }[39m
[31m+   const byID = new Map(items.map((it) => [it.msg_id, it]));[39m
[31m+   let settled = 0;[39m
[31m+   for (const e of withConv) {[39m
[31m+     const it = byID.get(e.msg_id);[39m
[31m+     const st = it && it.status;[39m
[31m+     // acked/duplicate：记账完成；not_found/not_in_scope：不可能再成功（已终态或归属他人）[39m
[31m+     if (st === S.ACKED || st === S.DUPLICATE || st === S.NOT_FOUND || st === S.NOT_IN_SCOPE) { settled++; continue; }[39m
[31m+     addPendingAck(cred.channel, e.msg_id, `duplicate_reack_${st || 'missing_item'}`, e.conversation_id);[39m
[31m+   }[39m
[31m+   log.info(`${label} 已补确认`, {[39m
[31m+     channel: cred.channel, total: ids.length, settled, retried: ids.length - settled,[39m
[31m+   });[39m
[31m+ }[39m
