[31m+ // processAckDetailedResult 处理服务端详细 ack 响应（P3-D 2026-08-15 + P0-6 2026-08-15）。[39m
[31m+ //[39m
[31m+ // 输入：ackRes（{status, acked, duplicate_count, not_found_count, items: [...]}}）+ ackIds（请求的 msg_ids）[39m
[31m+ // 输出：{ acked, duplicate, not_found, not_in_scope, retriable }[39m
[31m+ //   - acked        本次成功翻转行数（status='acked'）[39m
[31m+ //   - duplicate    幂等跳过行数（status='duplicate'，本地无需重发）[39m
[31m+ //   - not_found    不存在行数（status='not_found'，本地无需再尝试）[39m
[31m+ //   - not_in_scope 归属其他账号/方向行数（status='not_in_scope'，本地无需再尝试，防越权探测）[39m
[31m+ //   - retriable    需进入下轮 _pendingAck 重试的行数（status 缺失或响应未含详情）[39m
[31m+ //[39m
[31m+ // 设计原则：[39m
[31m+ //   - status='acked' / 'duplicate' 都视为"已处理"，不应再入 pendingAck[39m
[31m+ //   - status='not_found' / 'not_in_scope' 视为"不可能再 ack 成功"，也不应入 pendingAck[39m
[31m+ //   - 响应无 items 字段（老版本）按"全量成功"处理（保持兼容）[39m
[31m+ //   - 响应 ok 但部分 msg_id 没有对应 item（极少见）→ 入 pendingAck 下轮重试[39m
[31m+ export function processAckDetailedResult(ackRes, ackIds, channel = '', label = 'ack') {[39m
[31m+   const result = { acked: 0, duplicate: 0, not_found: 0, not_in_scope: 0, retriable: 0 };[39m
[31m+   if (!ackRes || ackRes.status !== 'ok') {[39m
[31m+     result.retriable = Array.isArray(ackIds) ? ackIds.length : 0;[39m
[31m+     return result;[39m
[31m+   }[39m
[31m+   const items = Array.isArray(ackRes.items) ? ackRes.items : null;[39m
[31m+   if (!items) {[39m
[31m+     result.acked = Array.isArray(ackIds) ? ackIds.length : 0;[39m
[31m+     return result;[39m
[31m+   }[39m
[31m+   // 新版本响应：per-msg-id 分类[39m
[31m+   const itemByMsgID = new Map(items.map((it) => [it.msg_id, it]));[39m
[31m+   for (const id of ackIds || []) {[39m
[31m+     if (!id) continue;[39m
[31m+     const it = itemByMsgID.get(id);[39m
[31m+     if (!it || !it.status) {[39m
[31m+       result.retriable++;[39m
[31m+       continue;[39m
[31m+     }[39m
[31m+     if (it.status === BRIDGE_PROTOCOL_V2.RESPONSE_STATUS.ACKED) result.acked++;[39m
[31m+     else if (it.status === BRIDGE_PROTOCOL_V2.RESPONSE_STATUS.DUPLICATE) result.duplicate++;[39m
[31m+     else if (it.status === BRIDGE_PROTOCOL_V2.RESPONSE_STATUS.NOT_FOUND) result.not_found++;[39m
[31m+     else if (it.status === BRIDGE_PROTOCOL_V2.RESPONSE_STATUS.NOT_IN_SCOPE) result.not_in_scope++;[39m
[31m+     else result.retriable++; [39m
[31m+   }[39m
[31m+   return result;[39m
[31m+ }[39m
