# ============================================================
# 用户端 Go 服务 (user-server) - 本地 .gitignore
# 路径相对于 user-server/ 目录本身
# ============================================================

# ---------- 依赖 ----------
vendor/
node_modules/
__pycache__/
*.pyc
*.pyo

# ---------- 环境配置（含敏感信息）----------
.env
.env.local
.env.*.local

# ---------- 日志 ----------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.workbuddy-ai/*

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
.claude/
.trae/
.sisyphus/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db

# ---------- 构建产物（Go 二进制）----------
# ⚠️ 这些模式必须锚定到仓库根（前导 `/`）。
# 裸模式（如 `seed`、`embedding-server`、`main`）会匹配**任意层级**的同名文件或目录，
# 从而把源码目录一并吞掉：`seed` 吞掉 cmd/seed/、`embedding-server` 吞掉
# cmd/embedding-server/、`main` 吞掉 internal/plugin/main/。
# 后果是这些目录下的源码永远不会入库，CI 全新克隆后直接编译失败。
/bin/
bin/
/user-server
/embedding-server
/bridge-mock
cmd/api/api
cmd/*/api
/main
*.exe
*.app
*.dll
*.so
*.dylib
*.a

# ---------- 测试覆盖 ----------
coverage/
coverage.out
coverage.html
*.cover
*.cover.out
*.out
*.test
*.prof
playwright-report/
playwright-report-api/
test-results/

# ---------- 临时文件 ----------
tmp/
temp/
uploads/
downloads/
.data/

# ---------- 数据库 / 持久化数据 ----------
*.db
data/
faiss_index/

# ---------- Docker ----------
docker-compose.override.yml

# ---------- 证书和密钥 ----------
*.pem
*.key
*.crt
*.p12

# ---------- 备份与缓存 ----------
*.bak
*.backup
*.bak.*
backups/

# ---------- 一次性调试产物 ----------
debug-*.html
reset-*.html
clear-*.html
fix-api-config*.html
debug-*.js
debug-*.sh
test_all_apis*.sh
test-all-apis*.sh

# ---------- 运行时授权文件 ----------
merchant.key
install.lock

# ---------- 开发工具配置 ----------
# .air.toml 已入仓（团队共享同一份热重载配置），仅排除本地覆盖文件
.air.local.toml
.air.*.local.toml

# ---------- 运行时上传目录（知识库样本数据，不进版本库；由运行时生成）----------
internal/aiagent/knowledge/controller/uploads/
# ---------- 一次性调试/构建产物 ----------
# ⚠️ 仅锚定根目录的二进制；裸模式 `seed` / `importfaq` 会吞掉 cmd/seed/ 与
# cmd/importfaq/ 源码目录（前者曾导致 12 个 seed 源码文件从未入库）。
/seed
/importfaq

# ---------- 运行时密钥（平台商户 api_secret，user-server 启动时写回）----------
config/.merchant_api_secret
